datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String    @map("password_hash")
  currency     String    @default("IDR")
  timezone     String    @default("Asia/Jakarta")
  theme        String    @default("system")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  accounts             Account[]
  categories           Category[]
  transactions         Transaction[]
  transactionTags      TransactionTag[]
  budgets              Budget[]
  savingsGoals         SavingsGoal[]
  savingsContributions SavingsContribution[]
  debts                Debt[]
  debtPayments         DebtPayment[]
  recurringRules       RecurringRule[]
  notifications        Notification[]
  auditLogs            AuditLog[]

  @@map("users")
}

model Account {
  id                 String    @id @default(uuid())
  userId             String    @map("user_id")
  name               String
  accountType        String    @map("account_type") // cash, bank, ewallet, credit_card, savings
  currency           String    @default("IDR")
  openingBalance     Decimal   @default(0) @map("opening_balance") @db.Decimal(15, 2)
  openingBalanceDate DateTime  @default(now()) @map("opening_balance_date")
  isArchived         Boolean   @default(false) @map("is_archived")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions         Transaction[]
  savingsGoals         SavingsGoal[]
  savingsContributions SavingsContribution[]
  debtPayments         DebtPayment[]
  recurringRules       RecurringRule[]

  @@index([userId])
  @@map("accounts")
}

model Category {
  id         String    @id @default(uuid())
  userId     String?   @map("user_id")
  name       String
  type       String    // income, expense
  parentId   String?   @map("parent_id")
  icon       String?
  color      String?
  isDefault  Boolean   @default(false) @map("is_default")
  isArchived Boolean   @default(false) @map("is_archived")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  user           User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent         Category?       @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children       Category[]      @relation("CategoryHierarchy")
  transactions   Transaction[]
  budgetItems    BudgetItem[]
  recurringRules RecurringRule[]

  @@index([userId, type])
  @@map("categories")
}

model Transaction {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  accountId       String    @map("account_id")
  categoryId      String?   @map("category_id")
  type            String    // income, expense, transfer, adjustment
  amount          Decimal   @db.Decimal(15, 2)
  transactionDate DateTime  @map("transaction_date")
  description     String?
  counterparty    String?
  paymentMethod   String?   @map("payment_method")
  transferGroupId String?   @map("transfer_group_id")
  recurringRuleId String?   @map("recurring_rule_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  account       Account              @relation(fields: [accountId], references: [id], onDelete: Restrict)
  category      Category?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  recurringRule RecurringRule?       @relation(fields: [recurringRuleId], references: [id], onDelete: SetNull)
  tags          TransactionTagLink[]

  @@index([userId, transactionDate])
  @@index([userId, type])
  @@index([userId, categoryId])
  @@index([userId, accountId])
  @@index([transferGroupId])
  @@map("transactions")
}

model TransactionTag {
  id     String @id @default(uuid())
  userId String @map("user_id")
  name   String

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions TransactionTagLink[]

  @@unique([userId, name])
  @@map("transaction_tags")
}

model TransactionTagLink {
  transactionId String @map("transaction_id")
  tagId         String @map("tag_id")

  transaction Transaction    @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  tag         TransactionTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([transactionId, tagId])
  @@map("transaction_tag_links")
}

model Budget {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  name             String
  periodType       String   @default("monthly") @map("period_type") // monthly, weekly, yearly, custom
  startDate        DateTime @map("start_date")
  endDate          DateTime @map("end_date")
  allocationMethod String   @default("percentage") @map("allocation_method") // percentage, fixed, hybrid
  incomeBasis      Decimal? @map("income_basis") @db.Decimal(15, 2)
  rolloverEnabled  Boolean  @default(false) @map("rollover_enabled")
  isLocked         Boolean  @default(false) @map("is_locked")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  items BudgetItem[]

  @@index([userId, startDate, endDate])
  @@map("budgets")
}

model BudgetItem {
  id          String  @id @default(uuid())
  budgetId    String  @map("budget_id")
  categoryId  String  @map("category_id")
  amountType  String  @default("percentage") @map("amount_type") // fixed, percentage
  amountValue Decimal @map("amount_value") @db.Decimal(15, 2)
  sortOrder   Int     @default(0) @map("sort_order")

  budget   Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([budgetId, categoryId])
  @@map("budget_items")
}

model SavingsGoal {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  name          String
  targetAmount  Decimal   @map("target_amount") @db.Decimal(15, 2)
  currentAmount Decimal   @default(0) @map("current_amount") @db.Decimal(15, 2)
  targetDate    DateTime? @map("target_date")
  accountId     String?   @map("account_id")
  status        String    @default("active") // active, completed, archived
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  account       Account?              @relation(fields: [accountId], references: [id], onDelete: SetNull)
  contributions SavingsContribution[]

  @@index([userId])
  @@map("savings_goals")
}

model SavingsContribution {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  goalId           String   @map("goal_id")
  amount           Decimal  @db.Decimal(15, 2)
  contributionDate DateTime @default(now()) @map("contribution_date")
  accountId        String?  @map("account_id")
  note             String?
  createdAt        DateTime @default(now()) @map("created_at")

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal    SavingsGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  account Account?    @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([userId, goalId])
  @@map("savings_contributions")
}

model Debt {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  type            String    // debt (utang), receivable (piutang)
  counterparty    String
  initialAmount   Decimal   @map("initial_amount") @db.Decimal(15, 2)
  remainingAmount Decimal   @map("remaining_amount") @db.Decimal(15, 2)
  interestRate    Decimal?  @map("interest_rate") @db.Decimal(5, 2)
  startDate       DateTime  @map("start_date")
  dueDate         DateTime? @map("due_date")
  status          String    @default("active") // active, paid, overdue, archived
  note            String?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments DebtPayment[]

  @@index([userId, type, status])
  @@map("debts")
}

model DebtPayment {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  debtId          String   @map("debt_id")
  amount          Decimal  @db.Decimal(15, 2)
  principalAmount Decimal  @map("principal_amount") @db.Decimal(15, 2)
  interestAmount  Decimal  @default(0) @map("interest_amount") @db.Decimal(15, 2)
  paymentDate     DateTime @default(now()) @map("payment_date")
  accountId       String?  @map("account_id")
  note            String?
  createdAt       DateTime @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  debt    Debt     @relation(fields: [debtId], references: [id], onDelete: Cascade)
  account Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([userId, debtId])
  @@map("debt_payments")
}

model RecurringRule {
  id                 String    @id @default(uuid())
  userId             String    @map("user_id")
  name               String
  type               String    // income, expense
  amount             Decimal   @db.Decimal(15, 2)
  accountId          String    @map("account_id")
  categoryId         String    @map("category_id")
  frequency          String    @default("monthly") // daily, weekly, monthly, yearly
  intervalValue      Int       @default(1) @map("interval_value")
  startDate          DateTime  @map("start_date")
  endDate            DateTime? @map("end_date")
  nextDueDate        DateTime  @map("next_due_date")
  reminderDaysBefore Int       @default(1) @map("reminder_days_before")
  isActive           Boolean   @default(true) @map("is_active")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  account      Account       @relation(fields: [accountId], references: [id], onDelete: Restrict)
  category     Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  transactions Transaction[]

  @@index([userId, isActive, nextDueDate])
  @@map("recurring_rules")
}

model Notification {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  type      String
  title     String
  message   String
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, entityType])
  @@map("audit_logs")
}
